'use client';

import React, { useState } from 'react';
import { X, Save, UserPlus, Info } from 'lucide-react';

interface AddParticipantDrawerProps {
    isOpen: boolean;
    onClose: () => void;
    onAdd: (participant: any) => Promise<void>;
    clubs: any[];
}

export function AddParticipantDrawer({ isOpen, onClose, onAdd, clubs }: AddParticipantDrawerProps) {
    const [name, setName] = useState('');
    const [shortCode, setShortCode] = useState('');
    const [type, setType] = useState('club');
    const [clubId, setClubId] = useState('');
    const [seed, setSeed] = useState<number | ''>('');
    const [status, setStatus] = useState('active');
    const [loading, setLoading] = useState(false);

    const handleSubmit = async (e: React.FormEvent) => {
        e.preventDefault();
        setLoading(true);
        try {
            await onAdd({
                name: name || (clubs.find(c => c.id === clubId)?.name) || 'Nuevo Participante',
                short_code: shortCode,
                type,
                club_id: clubId || null,
                seed: seed === '' ? null : Number(seed),
                status
            });
            // Reset form
            setName('');
            setShortCode('');
            setClubId('');
            setSeed('');
            onClose();
        } catch (err) {
            console.error(err);
        } finally {
            setLoading(false);
        }
    };

    if (!isOpen) return null;

    return (
        <div className="fixed inset-0 z-50 overflow-hidden">
            {/* Backdrop */}
            <div
                className="absolute inset-0 bg-black/60 backdrop-blur-sm transition-opacity animate-in fade-in"
                onClick={onClose}
            />

            {/* Panel */}
            <div className="absolute inset-y-0 right-0 w-full max-w-md bg-[#0a0a0b] border-l border-white/10 shadow-2xl animate-in slide-in-from-right duration-300">
                <form onSubmit={handleSubmit} className="flex flex-col h-full">
                    {/* Header */}
                    <div className="flex items-center justify-between p-6 border-b border-white/10 bg-white/[0.02]">
                        <div className="flex items-center gap-3">
                            <div className="w-10 h-10 rounded-xl bg-[#00a365]/10 border border-[#00a365]/20 flex items-center justify-center">
                                <UserPlus className="w-5 h-5 text-[#00a365]" />
                            </div>
                            <div>
                                <h3 className="text-lg font-bold text-white">Nuevo Participante</h3>
                                <p className="text-xs text-zinc-500">Añade un equipo o jugador al torneo</p>
                            </div>
                        </div>
                        <button
                            type="button"
                            onClick={onClose}
                            className="p-2 hover:bg-white/5 rounded-lg text-zinc-400 hover:text-white transition-all"
                        >
                            <X className="w-5 h-5" />
                        </button>
                    </div>

                    {/* Body */}
                    <div className="flex-1 overflow-y-auto p-6 space-y-6">
                        {/* Type Selector */}
                        <div className="space-y-2">
                            <label className="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Tipo de Participante</label>
                            <div className="grid grid-cols-3 gap-2">
                                {['club', 'national_team', 'individual'].map((t) => (
                                    <button
                                        key={t}
                                        type="button"
                                        onClick={() => setType(t)}
                                        className={`px-3 py-2 rounded-xl border text-xs font-semibold capitalize transition-all ${type === t
                                                ? 'bg-[#00a365]/10 border-[#00a365]/50 text-[#00a365]'
                                                : 'bg-white/5 border-white/10 text-zinc-400 hover:bg-white/10'
                                            }`}
                                    >
                                        {t === 'club' ? 'Club' : t === 'national_team' ? 'Selección' : 'Individual'}
                                    </button>
                                ))}
                            </div>
                        </div>

                        {type === 'club' && (
                            <div className="space-y-2 animate-in slide-in-from-top-2">
                                <label className="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Vincular con Club Existente</label>
                                <select
                                    value={clubId}
                                    onChange={(e) => {
                                        setClubId(e.target.value);
                                        const selected = clubs.find(c => c.id === e.target.value);
                                        if (selected) {
                                            setName(selected.name);
                                            setShortCode(selected.short_name || '');
                                        }
                                    }}
                                    className="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white focus:outline-none focus:border-[#00a365]/50"
                                >
                                    <option value="">Seleccionar un club...</option>
                                    {clubs.map(c => (
                                        <option key={c.id} value={c.id}>{c.name}</option>
                                    ))}
                                </select>
                                <p className="text-[10px] text-zinc-600 flex items-center gap-1">
                                    <Info className="w-3 h-3" />
                                    Mantiene el logo y datos actualizados desde la base central.
                                </p>
                            </div>
                        )}

                        <div className="space-y-2">
                            <label className="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Nombre del Participante</label>
                            <input
                                type="text"
                                required
                                placeholder="Ej: San Isidro Club"
                                value={name}
                                onChange={(e) => setName(e.target.value)}
                                className="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white placeholder:text-zinc-600 focus:outline-none focus:border-[#00a365]/50"
                            />
                        </div>

                        <div className="grid grid-cols-2 gap-4">
                            <div className="space-y-2">
                                <label className="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Código Corto</label>
                                <input
                                    type="text"
                                    placeholder="Ej: SIC"
                                    value={shortCode}
                                    onChange={(e) => setShortCode(e.target.value)}
                                    className="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white font-mono placeholder:text-zinc-600 focus:outline-none focus:border-[#00a365]/50"
                                />
                            </div>
                            <div className="space-y-2">
                                <label className="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Seed / Ranking</label>
                                <input
                                    type="number"
                                    placeholder="Ej: 1"
                                    value={seed}
                                    onChange={(e) => setSeed(e.target.value ? Number(e.target.value) : '')}
                                    className="w-full bg-black/40 border border-white/10 rounded-xl px-4 py-2.5 text-sm text-white font-mono placeholder:text-zinc-600 focus:outline-none focus:border-[#00a365]/50"
                                />
                            </div>
                        </div>

                        <div className="space-y-2">
                            <label className="text-[11px] font-bold uppercase tracking-wider text-zinc-500">Estado Inicial</label>
                            <div className="grid grid-cols-2 gap-2">
                                {['active', 'pending'].map((s) => (
                                    <button
                                        key={s}
                                        type="button"
                                        onClick={() => setStatus(s)}
                                        className={`px-3 py-2 rounded-xl border text-xs font-semibold capitalize transition-all ${status === s
                                                ? 'bg-white/10 border-white/30 text-white'
                                                : 'bg-white/5 border-white/10 text-zinc-500'
                                            }`}
                                    >
                                        {s === 'active' ? 'Activo' : 'Pendiente'}
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>

                    {/* Footer */}
                    <div className="p-6 border-t border-white/10 bg-white/[0.02]">
                        <button
                            type="submit"
                            disabled={loading || (!name && !clubId)}
                            className="w-full flex items-center justify-center gap-2 px-6 py-3 bg-[#00a365] hover:bg-[#008b56] disabled:opacity-50 disabled:cursor-not-allowed text-white text-sm font-bold rounded-xl transition-all shadow-lg shadow-[#00a365]/20"
                        >
                            {loading ? (
                                <div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin" />
                            ) : (
                                <Save className="w-4 h-4" />
                            )}
                            {loading ? 'Guardando...' : 'Guardar Participante'}
                        </button>
                    </div>
                </form>
            </div>
        </div>
    );
}
