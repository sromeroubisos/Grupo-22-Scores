.agent/
.agents/
.codex_tmp/
.playwright-mcp/
.cursor/
*.log
*.recover
supabase/.temp/
tmp/
tmp_*

# local-only admin login shortcuts
/public/local-dev/

carrera-capturas/

# Capturas de verificación sueltas en la raíz. Las imágenes que SÍ se publican
