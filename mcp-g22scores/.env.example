G22_BASE_URL=https://g22scores.com
G22_API_KEY=replace-with-your-api-key

# Required: clients must send Authorization: Bearer <MCP_INBOUND_TOKEN> (min 32 chars).
MCP_INBOUND_TOKEN=replace-with-a-long-random-token

# Optional
PORT=3001
MCP_PATH=/mcp
G22_TIMEOUT_MS=20000
MCP_MAX_SSE_SESSIONS=20
# HOST=0.0.0.0
# Local development only: disables inbound auth and binds to 127.0.0.1.
# MCP_ALLOW_NO_AUTH=true
