{
  "name": "rapid-prominence",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:turbo": "next dev --turbopack",
    "dev:clean": "next dev --turbopack=false",
    "clean": "rm -rf .next .turbo",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "gen:db-types": "supabase gen types typescript --project-id vxsolicapdcpemfsahbk --schema public > src/lib/database.types.ts",
    "import:tournaments": "npx tsx src/scripts/trigger-import.ts",
    "backfill:club-derivatives": "node src/scripts/backfill-club-derivatives.cjs",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:captain": "node --test \"src/features/captain/**/*.test.ts\"",
    "test:captain-freeze": "node scripts/captain-freeze.mjs",
    "test:perf": "node --test src/lib/perf/editTrace.test.ts src/lib/perf/labFlags.test.ts",
    "lab:guard": "node scripts/etapa0-lab-guard.mjs",
    "dev:perf-lab": "node scripts/dev-perf-lab.mjs",
    "prebuild": "node scripts/gen-logo-manifest.mjs",
    "predev": "node scripts/gen-logo-manifest.mjs",
    "logos": "node scripts/gen-club-placeholders.mjs && node scripts/gen-competition-placeholders.mjs && node scripts/gen-logo-manifest.mjs && node scripts/gen-logo-inventory.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "mercadopago": "^2.12.0",
    "next": "16.1.6",
    "pdfjs-dist": "^5.4.624",
    "pg": "^8.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.4.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.11",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19",
    "dotenv": "^17.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "supabase": "^2.76.11",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
